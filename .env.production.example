# ---------------------------------------------------------------------------
# ERP Pilot — production environment template
# ---------------------------------------------------------------------------
# Copy to `.env` on the server and fill in every value marked REQUIRED.
# Never commit the real .env. Keys absent from .env fall back to the defaults
# in config/, and several of those defaults are unsafe for production — this
# file exists so they are set explicitly rather than inherited.
# ---------------------------------------------------------------------------

APP_NAME="ERP Pilot"
APP_ENV=production
# REQUIRED. A leaked APP_KEY decrypts sessions, cookies and encrypted columns.
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://erp.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# REQUIRED. Without a maintenance window you cannot deploy safely.
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging — an ERP must keep an audit trail that is actually readable.
# ---------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ---------------------------------------------------------------------------
# Database — REQUIRED. SQLite is for development only; the fiscal/ledger
# queries and row locking in ACCOUNTS and INVENTORY are written for a server
# RDBMS. MySQL/MariaDB or PostgreSQL.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_pilot
DB_USERNAME=erp_app
# REQUIRED. Give this user only the ERP schema — never root.
DB_PASSWORD=

# docker-compose.yml is a development / single-host stack and is not the production path. If you do
# run it here, it requires MYSQL_ROOT_PASSWORD and MYSQL_PASSWORD from the environment and refuses to
# start without them; it publishes no database port. See the header of that file.

# Keep connections tight; the app opens many short transactions.
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Session — REQUIRED. `database` or `redis`, never `file` on multi-node.
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only set true once the site is served exclusively over TLS.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# ---------------------------------------------------------------------------
# Cache / queue — REQUIRED for scheduled jobs (attendance sync, document
# expiry, payroll) to run at all.
# ---------------------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# CORE module — access control
# ---------------------------------------------------------------------------
# REQUIRED. Seeded by SuperAdminSeeder. Leaving the default `password` on a
# production box hands over every module.
CORE_SUPER_ADMIN_NAME="System Administrator"
CORE_SUPER_ADMIN_EMAIL=
CORE_SUPER_ADMIN_PASSWORD=

# Runtime guard (Modules\CORE\Support\PublishedCredentialGuard). In APP_ENV=production a login
# presenting a password this repository publishes — `password`, in config/core.php, .env.example,
# SuperAdminSeeder and UserFactory — is refused and logged at critical, and SuperAdminSeeder refuses
# to run at all until a real secret is set. Leave true: setting the variables above is the fix, not
# switching the guard off. Set false only for a deliberately throwaway production demo.
CORE_BLOCK_PUBLISHED_CREDENTIALS=true

# Self-registration is OFF. An internal ERP must not let anonymous visitors
# mint accounts; the register route 404s while this is false.
CORE_ALLOW_REGISTRATION=false
# Leave empty: a self-registered account should get no role, and therefore no
# module access, until an administrator assigns one.
CORE_DEFAULT_REGISTRATION_ROLE=

# ---------------------------------------------------------------------------
# Security headers (App\Http\Middleware\SecurityHeaders)
# ---------------------------------------------------------------------------
CORE_SECURITY_HEADERS=true
# Ship CSP in report-only mode first and watch violations before enforcing.
CORE_CSP_REPORT_ONLY=false

# ---------------------------------------------------------------------------
# ACCOUNTS — posting integrity
# ---------------------------------------------------------------------------
# Refuse to post a journal into a closed or missing fiscal period rather than
# silently skipping the ledger write.
ACCOUNTS_REQUIRE_FISCAL_OPEN=true

# ---------------------------------------------------------------------------
# Biometric devices (HRM attendance)
# ---------------------------------------------------------------------------
# Device IPs are stored per-device in the database; these are only defaults.
ZKTECO_TIMEOUT=5
# Sync hits real hardware — never leave this low enough to hammer a device.
ZKTECO_SYNC_RATE_LIMIT=60

# ---------------------------------------------------------------------------
# Mail — REQUIRED for password resets. Without it, a locked-out user has no
# recovery path and an admin must edit the database.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="erp@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Document storage (HRM employee documents)
# ---------------------------------------------------------------------------
# Employee documents are written to the `private` disk and streamed through an
# authorising controller — do not point this at a public bucket.
PRIVATE_DISK=local

# ---------------------------------------------------------------------------
# Vite
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
