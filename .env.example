APP_NAME="ERP Pilot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Database: SQLite for dev, MySQL for prod ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# For MySQL prod:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=erp_pilot
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=log

# --- Module Codes ---
SALES_QUOTATION_PREFIX=QT-
SALES_ORDER_PREFIX=SO-
SALES_INVOICE_PREFIX=INV-
SALES_POS_PREFIX=POS-
SALES_PAYMENT_PREFIX=PAY-
PURCHASE_ORDER_PREFIX=PO-
PURCHASE_RECEIPT_PREFIX=GRN-
PURCHASE_BILL_PREFIX=PB-
PURCHASE_PAYMENT_PREFIX=PP-
SALES_VAT_RATE=0
SALES_DISCOUNT_MAX=100
ACCOUNTS_SALES_CODE=4001
ACCOUNTS_RECEIVABLE_CODE=1100
ACCOUNTS_PAYABLE_CODE=2100
ACCOUNTS_INVENTORY_CODE=1200
ACCOUNTS_VAT_PAYABLE_CODE=2110
ACCOUNTS_VAT_INPUT_CODE=1330
ACCOUNTS_CASH_CODE=1001

VITE_APP_NAME="${APP_NAME}"
