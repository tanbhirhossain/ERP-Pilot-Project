APP_NAME="ERP Pilot"
APP_ENV=local
APP_KEY=
# Correct for THIS file, which is the local template — and wrong for a server. Copy
# .env.production.example onto a deployment instead. If this file reaches a server anyway,
# ProductionDebugGuard forces APP_DEBUG off at boot when APP_ENV=production and writes a critical log
# line naming the mistake, so debug output cannot be rendered; the site keeps serving.
# Switch the guard off with CORE_FORCE_DEBUG_OFF_IN_PRODUCTION=false, in writing, if you really want
# stack traces in production.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# --- Database: SQLite for dev, MySQL for prod ---
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# For MySQL prod:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=erp_pilot
# DB_USERNAME=root
# DB_PASSWORD=

# --- docker-compose.yml ------------------------------------------------------
# Required by docker-compose.yml, which refuses to start while either password is empty. Nothing in
# that file states a password: a credential committed to a public repository is a credential leaked.
# Leave MYSQL_DATABASE and MYSQL_USER empty to take the defaults (erp_pilot / erp_app). The database
# container is not published on the host; see the header of docker-compose.yml.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=log

# --- Module Codes ---
SALES_QUOTATION_PREFIX=QT-
SALES_ORDER_PREFIX=SO-
SALES_INVOICE_PREFIX=INV-
SALES_POS_PREFIX=POS-
SALES_PAYMENT_PREFIX=PAY-
PURCHASE_ORDER_PREFIX=PO-
PURCHASE_RECEIPT_PREFIX=GRN-
PURCHASE_BILL_PREFIX=PB-
PURCHASE_PAYMENT_PREFIX=PP-
SALES_VAT_RATE=0
SALES_DISCOUNT_MAX=100
ACCOUNTS_SALES_CODE=4001
ACCOUNTS_RECEIVABLE_CODE=1100
ACCOUNTS_PAYABLE_CODE=2100
ACCOUNTS_INVENTORY_CODE=1200
ACCOUNTS_VAT_PAYABLE_CODE=2110
ACCOUNTS_VAT_INPUT_CODE=1330
ACCOUNTS_CASH_CODE=1001

VITE_APP_NAME="${APP_NAME}"

# --- CORE: access control (see .env.production.example for the hardened set) --
# Seeded by SuperAdminSeeder; override in every non-development environment.
CORE_SUPER_ADMIN_NAME="Super Admin"
CORE_SUPER_ADMIN_EMAIL=admin@example.com
CORE_SUPER_ADMIN_PASSWORD=password
# Refuse the published credentials above when APP_ENV=production. Has no effect in local/testing,
# which is why this file can keep `password` for convenience. See PublishedCredentialGuard.
CORE_BLOCK_PUBLISHED_CREDENTIALS=true
# Self-registration is closed by default: the register route returns 404.
CORE_ALLOW_REGISTRATION=false
CORE_DEFAULT_REGISTRATION_ROLE=

# --- CORE: HTTP security headers ---------------------------------------------
CORE_SECURITY_HEADERS=true
CORE_CSP_REPORT_ONLY=false
